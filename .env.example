# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file — it contains secrets.

# --- Discord (required) -----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID from the "General Information" page of your application
DISCORD_APPLICATION_ID=

# Optional: guild (server) IDs that get instant slash-command sync,
# comma-separated (e.g. a test server and your main server: 123,456).
# Without it, commands sync globally which can take up to an hour.
DEV_GUILD_IDS=

# --- Database (required) ----------------------------------------------------
# Async PostgreSQL URL. Plain `postgresql://` or `sqlite://` URLs are
# automatically upgraded to their async drivers (+asyncpg / +aiosqlite).
# Docker Compose default:
#   postgresql+asyncpg://arma:arma@localhost:5432/arma_unit
# Quick local spin without PostgreSQL:
#   sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://arma:arma@localhost:5432/arma_unit

# --- Application ------------------------------------------------------------
# One of: development, staging, production
ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- HTTP API ---------------------------------------------------------------
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8000

# --- GitHub mission repository ------------------------------------------------
# The separate Git repository holding the unit's missions (see PROJECT.md).
# Owner = the GitHub user/organisation, repository = the repo name:
#   https://github.com/<OWNER>/<REPOSITORY>
GITHUB_MISSIONS_OWNER=
GITHUB_MISSIONS_REPOSITORY=
GITHUB_MISSIONS_BRANCH=main
# Fine-grained personal access token with read access to that repository's
# contents. Optional for public repositories (but strongly recommended —
# unauthenticated GitHub API access is limited to 60 requests/hour).
GITHUB_TOKEN=

# --- AI unit assistant ---------------------------------------------------------
# Which provider /ask uses. Switching is pure configuration — no code changes.
#   openai -> uses OPENAI_API_KEY (default model gpt-5-mini)
#   gemini -> uses GEMINI_API_KEY (default model gemini-2.5-flash)
AI_PROVIDER=openai
# Leave blank for the provider default, or pin a specific model
AI_MODEL=
# Advanced: point at any other OpenAI-compatible endpoint
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=700
AI_REQUESTS_PER_MINUTE=4
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Google Sheets export (optional) -------------------------------------------
# Unit data mirrored to a staff spreadsheet (/unit sheets + daily auto-export).
# 1. console.cloud.google.com -> create project -> enable "Google Sheets API"
# 2. Create a service account -> keys -> add JSON key
# 3. Paste the ENTIRE JSON below as one line
# 4. Create a Google Sheet, share it with the service account's email (Editor)
# 5. Copy the sheet ID from its URL (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
