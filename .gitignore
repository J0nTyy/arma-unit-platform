# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases
*.db
*.sqlite3

# OS / IDE
.vscode/
.idea/
Thumbs.db
.DS_Store

# Personal notes — never committed
ideas.txt
notes.txt

# Unit-specific configuration (lore, knowledge, personality) — private per
# deployment; templates/unit/ ships the public starting points instead
unit/*
!unit/README.md

# Server-generated data (per-guild folders, exports, memory snapshots)
data/*
!data/README.md
